# Razorpay API Credentials (Test Mode)
# Leave as default mock or provide real keys from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Groq API Configuration (for isolated incident explanation)
# https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_API_BASE=https://api.groq.com/openai/v1

# Database Configuration
DATABASE_URL=sqlite:///./ghost_payments.db

# Chaos Simulation Default Probabilities (0.0 to 1.0)
DEFAULT_DROP_RATE=0.40
DEFAULT_DELAY_RATE=0.20
DEFAULT_CORRUPT_RATE=0.10

# Reconciliation Poller Configuration
# Cutoff in seconds before pending orders are scanned
RECONCILIATION_CUTOFF_SECONDS=10
POLLER_INTERVAL_SECONDS=30
